# Copy to .env (which is gitignored) and fill in. Loaded automatically from
# beside main.py; no `set`/`export` needed.

# Must match COMPETITOR_NOTE_TOKEN in the Laravel app's .env exactly.
# If these differ every request 401s, and Laravel silently hides the card.
COMPETITOR_NOTE_TOKEN=change-me

OLLAMA_URL=http://127.0.0.1:11434

# Per Ollama call, seconds. A 7B answers this prompt in roughly 15-25s once
# loaded, and the first call after a cold start pays the model-load cost on top.
# Too low and the call raises, gets swallowed, and you get fallback prose at
# HTTP 200 with nothing in the log to explain why.
OLLAMA_TIMEOUT=60

# The guard handles the numbers whatever the model size; the bigger model is for
# the claims around them (a 3B invented a room type for us). See README.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Only these may be requested by the payload. Anything else falls back to the
# default. Without this, a caller holding the token could make this box pull and
# run an arbitrary model. Every name here must actually be installed: an
# allowlisted-but-missing model 404s and lands in the fallback with no error.
OLLAMA_MODEL_ALLOWLIST=qwen2.5:7b-instruct
